# Production settings for z-lab-cockpit (docker-compose.yml behind a reverse proxy).
# Copy to .env on the server and fill in every empty value.
# Generate APP_KEY once with: php artisan key:generate --show

APP_NAME="Z-Lab Cockpit"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public address as seen by visitors; used for all links in mails.
APP_URL=https://cockpit.example.org

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

# Reverse proxy in front of the app container (comma separated IPs or CIDR ranges).
# Behind a proxy on the docker host, requests arrive from the docker network gateway,
# e.g. 172.16.0.0/12. Never use "*" while port 8000 is reachable from outside.
TRUSTED_PROXIES=172.16.0.0/12

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# SQLite lives in the mounted storage volume, so it survives image rebuilds.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# docker-compose.yml runs a queue worker, so mails are sent in the background.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# OAuth2/OpenID Connect login for the cockpit (alexandergabriel/filament-oauth2)
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Keycloak: https://DOMAIN/realms/REALM/protocol/openid-connect
OAUTH2_BASE_URL=
OAUTH2_URL_AFTER_LOGOUT="${APP_URL}"
OAUTH2_SCOPES="profile email openid"
# Sync client roles from the access token to Filament Shield roles.
# Only users with a role (or a direct permission) can enter the cockpit.
OAUTH2_UPDATE_ROLES=false
# Comma separated client roles taken from the access token, empty: all roles
# OAUTH2_ALLOWED_ROLES=
OAUTH2_VERIFY_SSL=true
