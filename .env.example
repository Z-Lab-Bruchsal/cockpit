APP_NAME="Z-Lab Cockpit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Reverse proxies whose X-Forwarded-* headers are trusted (comma separated IPs or CIDR ranges)
# TRUSTED_PROXIES=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_TEST_MODE=false
MAIL_TEST_MODE_RECIPIENT=

# Cockpit mailbox: incoming mails become internal messages (empty IMAP_HOST = disabled)
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OAuth2/OpenID Connect login for the cockpit (alexandergabriel/filament-oauth2)
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Keycloak: https://DOMAIN/realms/REALM/protocol/openid-connect
OAUTH2_BASE_URL=
# OAUTH2_URL_AUTHORIZE="${OAUTH2_BASE_URL}/auth"
# OAUTH2_URL_ACCESS_TOKEN="${OAUTH2_BASE_URL}/token"
# OAUTH2_URL_RESOURCE_OWNER_DETAILS="${OAUTH2_BASE_URL}/userinfo"
# OAUTH2_URL_LOGOUT="${OAUTH2_BASE_URL}/logout"
OAUTH2_URL_AFTER_LOGOUT="${APP_URL}"
OAUTH2_SCOPES="profile email openid"
# Sync client roles from the access token to Filament Shield roles
OAUTH2_UPDATE_ROLES=false
OAUTH2_VERIFY_SSL=true
# Comma separated client roles taken from the access token, empty: all roles
# OAUTH2_ALLOWED_ROLES=

# Local OpenAI-compatible LLM endpoint (e.g. llama-swap); empty URL hides AI features
LOCAL_AI_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL_DRAFT=qwen3.5-35b-a3b
LOCAL_AI_MODEL_FAST=qwen3.5-9b
LOCAL_AI_MODEL_TOOLS=glm-4.7-flash
LOCAL_AI_TIMEOUT=180
LOCAL_AI_THINKING=false
